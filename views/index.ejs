<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <!-- viewport: sin esto el movil "simula" escritorio y el CSS responsive no funciona -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- esto es lo que pone arriba en la pestaña, por eso no está en el body -->
  <title>Document</title>

  <!-- Un solo CSS. style.css importa el resto con @import -->


<!-- Hidden menu markup (no CSS, just HTML) -->
 <aside class="off-canvas">
  <nav id="off-canvas-menu">
<button class="off-canvas-close">&times;</button>
  <ul>
    <li><a href="/">Home</a></li>
    <li><a href="#programs">Programs</a></li>
    <li><a href="#about">About</a></li>
    <li><a href="/contacto">Contact</a></li>
    <li><a href="#">Student Portal</a></li>
  </ul>
</nav>
</aside>




<aside class="off-canvas"></aside>


  <link rel="stylesheet" href="/stylesheets/style.css">
  <script>
    console.log("Hola") //este script aparecerá antes que el body ya que está en el HEAD
  </script>
</head>
<body>

<section class="header">
  <nav class="header-navbar">
    <img src="/public/images/photo.png" alt="">
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="#programs" id="open_offcanvas">Programs</a></li>
      <li><a href="#about">About</a></li>
      
    </ul>
    <ul>
      <li><a href="/contacto">Contact</a></li>
    </ul>
  </nav>
</section>

  <!-- Portada a pantalla completa. Estilos: hero.css -->
  <section class="hero">
    <h1>Welcome to CESUR </h1>
    <!-- Subtitulo. Estilo global de small: base.css -->
    <small>- Vocational Training Center</small>
    <p>CESUR specializes in computer science education, offering cutting-edge Vocational Training programs designed for the tech industry. Join a forward-thinking learning community and boost your professional future in IT with us.</p>
  </section>

  <!-- Programas del centro: fila de 4 cards.
       id="programs" es el destino del enlace #programs del nav.
       Estilos: courses.css -->
  <section class="courses" id="programs">
    <h2>Our Programs</h2>

    <!-- courses-inner = la fila. En courses.css lleva justify-content: flex-end
         para pegar las cards a la derecha -->
    <div class="courses-inner">

      <!-- Card: .card (caja) > img + .card-inner (texto). Estilos en card.css -->
      <div class="card">
        <!-- seed/webdev: fuerza SIEMPRE la misma foto, no cambia al recargar -->
        <img src="https://picsum.photos/seed/webdev/400/250" alt="Student writing the code of a web page">
        <div class="card-inner">
          <h4>Web Application Development</h4>
          <p>Two-year program on HTML5, CSS3, JavaScript and Node.js. Learn to build, test and deploy full-stack web applications.</p>
          <p class="card-meta">2 years &middot; On campus</p>
        </div>
      </div>

      <div class="card">
        <img src="https://picsum.photos/seed/mobileapps/400/250" alt="Developer testing a mobile app on a smartphone">
        <div class="card-inner">
          <h4>Multiplatform App Development</h4>
          <p>Design mobile and desktop applications for Android, iOS and Windows using Java, Kotlin and Swift.</p>
          <p class="card-meta">2 years &middot; On campus</p>
        </div>
      </div>

      <div class="card">
        <img src="https://picsum.photos/seed/networks/400/250" alt="Server rack inside a data centre">
        <div class="card-inner">
          <h4>Network Systems Administration</h4>
          <p>Deploy servers, networks and cloud infrastructure. Prepare for the CCNA and Linux administration certifications.</p>
          <p class="card-meta">2 years &middot; On campus</p>
        </div>
      </div>

      <div class="card">
        <img src="https://picsum.photos/seed/cybersecurity/400/250" alt="Security analyst monitoring network traffic on screens">
        <div class="card-inner">
          <h4>Cybersecurity &amp; Ethical Hacking</h4>
          <p>Learn threat analysis, penetration testing and digital forensics to protect corporate systems and data.</p>
          <p class="card-meta">1 year &middot; Hybrid</p>
        </div>
      </div>

    </div>
  </section>

  <!-- Un solo footer. Estilos: footer.css -->
  <footer class="footer">
    <!-- El &copy; es una entidad HTML: pinta el simbolo © -->
    <!-- footer-inner = la fila de 3 columnas -->
    <div class="footer-inner">
      <div class="footer-inner-col">
        <h3>About CESUR</h3>
        <ul>
          <!-- href="#" es un enlace falso de ejemplo; en tu web pon rutas reales -->
          <li><a href="#">Who We Are</a></li>
          <li><a href="#">Mission & Vision</a></li>
          <li><a href="#">Our Team</a></li>
        </ul>
      </div>
      <div class="footer-inner-col">
        <h3>Programs</h3>
        <ul>
          <li><a href="#">Computer Science</a></li>
          <li><a href="#">Web Development</a></li>
          <li><a href="#">Network Administration</a></li>
        </ul>
      </div>
      <div class="footer-inner-col">
        <h3>Contact</h3>
        <ul>
          <!-- /contacto es una ruta de Express (routes/index.js), no un archivo .html -->
          <li><a href="/contacto">Contact Us</a></li>
          <li><a href="#">Admissions</a></li>
          <li><a href="#">Events</a></li>
        </ul>
      </div>
    </div>
    <!-- Raya entre columnas y copyright. No es un <hr>, es un div pintado con CSS -->
    <div class="footer-line"></div>
    <p>&copy; 2026 CESUR - Empowering your future in Computer Science. All rights reserved.</p>
  </footer>

<!-- Tendria que tener un menu hidden pero de momento
 El JS va dentro del public porque se va a ejecutar en el navegador-->




<script src="/javascripts/app.js"></script>




</body>
</html>
